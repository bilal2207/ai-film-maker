# ==============================================================================
# AI Filmmaker - Local Development Environment Configuration
# ==============================================================================

# Core Go API Service
PORT=8080
API_HOST=localhost
API_PORT=8080

# Python AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=localhost

# Web Frontend
VITE_API_URL=http://localhost:8080

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aifilmmaker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aifilmmaker?sslmode=disable

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
